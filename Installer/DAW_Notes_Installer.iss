; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=DAW Notes
AppVersion=2.0.0
AppPublisher=Un(d)AbtanzBAR
AppPublisherURL=https://www.undabtanzbar.de
DefaultDirName={autopf}\DAW Notes
DefaultGroupName=DAW Notes
UninstallDisplayIcon={app}\DAW Notes.exe
Compression=lzma2
SolidCompression=yes
OutputBaseFilename=DAW_Notes_Setup_v2.0.0
OutputDir=Output

; WICHTIG: Erzwingt die Installation in den echten 64-Bit "Program Files"-Ordner
ArchitecturesInstallIn64BitMode=x64compatible
; Die settings.ini liegt pro Benutzer in %APPDATA%\DAW Notes
UsedUserAreasWarning=no
ShowLanguageDialog=yes

[Languages]
Name: "german"; MessagesFile: "compiler:Languages\German.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"

[Files]
; 1. Standalone-Anwendung
Source: "..\Builds\VisualStudio2026\x64\Release\Standalone Plugin\DAW Notes.exe"; DestDir: "{app}"; Flags: ignoreversion

; 2. VST3 Plugin (Ganzes .vst3-Bundle-Verzeichnis samt Unterordnern kopieren)
Source: "..\Builds\VisualStudio2026\x64\Release\VST3\DAW Notes.vst3\*"; DestDir: "{commoncf64}\VST3\DAW Notes.vst3"; Flags: ignoreversion recursesubdirs createallsubdirs

; 3. Sprachdateien (alle drei zum späteren Umstellen) + die zur Setup-Sprache passende settings.ini
Source: "..\Resources\Languages\set_german.ini"; DestDir: "{app}\Languages"; Flags: ignoreversion
Source: "..\Resources\Languages\set_english.ini"; DestDir: "{app}\Languages"; Flags: ignoreversion
Source: "..\Resources\Languages\set_france.ini"; DestDir: "{app}\Languages"; Flags: ignoreversion
Source: "..\Resources\Languages\set_german.ini"; DestDir: "{userappdata}\DAW Notes"; DestName: "settings.ini"; Languages: german; Flags: ignoreversion
Source: "..\Resources\Languages\set_english.ini"; DestDir: "{userappdata}\DAW Notes"; DestName: "settings.ini"; Languages: english; Flags: ignoreversion
Source: "..\Resources\Languages\set_france.ini"; DestDir: "{userappdata}\DAW Notes"; DestName: "settings.ini"; Languages: french; Flags: ignoreversion

[Icons]
; Startmenü-Eintrag für Standalone
Name: "{group}\DAW Notes"; Filename: "{app}\DAW Notes.exe"
; Desktop-Icon (Optional)
Name: "{autodesktop}\DAW Notes"; Filename: "{app}\DAW Notes.exe"

[Run]
; Option: DAW Notes nach der Installation direkt starten
Filename: "{app}\DAW Notes.exe"; Description: "DAW Notes jetzt starten"; Flags: postinstall nowait skipifsilent

[Code]
// Eine vorhandene (evtl. angepasste) settings.ini nicht stillschweigend verlieren: vorher sichern
procedure CurStepChanged(CurStep: TSetupStep);
var
  Ini, Backup: String;
begin
  if CurStep = ssInstall then
  begin
    Ini := ExpandConstant('{userappdata}\DAW Notes\settings.ini');
    Backup := ExpandConstant('{userappdata}\DAW Notes\settings_backup.ini');
    if FileExists(Ini) then
    begin
      DeleteFile(Backup);
      RenameFile(Ini, Backup);
    end;
  end;
end;
