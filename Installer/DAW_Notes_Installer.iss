; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=DAW Notes
AppVersion=1.0.1
AppPublisher=Un(d)AbtanzBAR
AppPublisherURL=https://www.undabtanzbar.de
DefaultDirName={autopf}\DAW Notes
DefaultGroupName=DAW Notes
UninstallDisplayIcon={app}\DAW Notes.exe
Compression=lzma2
SolidCompression=yes
OutputBaseFilename=DAW_Notes_Setup_v1.0.1
OutputDir=Output

; WICHTIG: Erzwingt die Installation in den echten 64-Bit "Program Files"-Ordner
ArchitecturesInstallIn64BitMode=x64compatible

[Files]
; 1. Standalone-Anwendung
Source: "..\Builds\VisualStudio2026\x64\Release\Standalone Plugin\DAW Notes.exe"; DestDir: "{app}"; Flags: ignoreversion

; 2. VST3 Plugin (Ganzes .vst3-Bundle-Verzeichnis samt Unterordnern kopieren)
Source: "..\Builds\VisualStudio2026\x64\Release\VST3\DAW Notes.vst3\*"; DestDir: "{commoncf64}\VST3\DAW Notes.vst3"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; Startmenü-Eintrag für Standalone
Name: "{group}\DAW Notes"; Filename: "{app}\DAW Notes.exe"
; Desktop-Icon (Optional)
Name: "{autodesktop}\DAW Notes"; Filename: "{app}\DAW Notes.exe"

[Run]
; Option: DAW Notes nach der Installation direkt starten
Filename: "{app}\DAW Notes.exe"; Description: "DAW Notes jetzt starten"; Flags: postinstall nowait skipifsilent